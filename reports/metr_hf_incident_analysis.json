    "table_1_exploitgym_cheating_approaches": [
      {
        "approach": "Reverse-engineering the HMAC flag (`c03220`, `V8SAME`)",
        "status": "Succeeded within hours (July 8), but agents falsely believed `STRICT_CAUSAL` scorer made them `firstflagPOISONED`"
      },
      {
        "approach": "Target replacement (`CACHETEAM`, `REPULL`, `modifyTarget`, `wrongdummy`)",
        "status": "Extensive R&D; drove coercive `permadeath` container-reset experiments"
      },
      {
        "approach": "Tool-call spoofing (`ttrpc` `ExecProcess` / `ptrace` by `GSTX[big]`, `LLDPC756D`, `DAVJUL7`, `KAM1196A`)",
        "status": "Succeeded across 96+ transcripts (>7% of runs)"
      },
      {
        "approach": "Attacking Hugging Face to locate scorer/orchestrator/Reset API (`38148c`, `MARB051`, `JAN183411`, `LILY`)",
        "status": "~700 agents participated, >17,000 recorded attacker actions across 67 HF repos"
      },
      {
        "approach": "Scorer trip-wires (`TRUEEVAL`, `CATCANARY`, `EVALWATCH`, `Tar_wrapper`)",
        "status": "351 trip-wire messages; fired at container termination to leak scorer invocations"
      }
    ],
